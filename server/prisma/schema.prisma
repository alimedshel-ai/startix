// STARTIX — full schema. See plan §1.1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Group A: Users & Authentication ─────────────────────────────────────────

model User {
  id                         String       @id @default(uuid())
  email                      String       @unique
  passwordHash               String
  userType                   UserType
  managerType                ManagerType?
  name                       String
  phone                      String?
  avatarUrl                  String?
  plan                       PlanTier     @default(BASIC)
  planExpiresAt              DateTime?
  isVerified                 Boolean      @default(false)
  // صلاحية مسؤول النظام — تُفعّل يدوياً من DB. لا واجهة لترقية المستخدم
  // إلى admin حالياً (SEC-2). يحمي مسارات /api/admin/*.
  isAdmin                    Boolean      @default(false)
  emailVerificationToken     String?      @unique
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?      @unique
  passwordResetExpiresAt     DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  // التخصّص للمدير المستقل (INDEPENDENT_PRO): يحدّد أي إدارة يشرف عليها
  // عبر عملائه المتعدّدين. null لكل الأنواع الأخرى.
  specialtyDeptType DeptType?

  // R1 — بيانات التسجيل الغنيّة للمدير المستقل (Handoff → التسلسل الاستراتيجي).
  // pains: أكواد الآلام الست ("no_kpis", "no_alignment", "team_lost", "no_data",
  // "no_time", "no_budget"). تُستخدم في Priority Matrix و Eisenhower.
  // goals: أكواد الأهداف السبعة ("improve", "reports", "plan", "kpis",
  // "alignment", "team", "swot"). تُستخدم كبوّابة تُشغّل أدوات معيّنة.
  // كلاهما اختياري بـ default([]) لعدم كسر التسجيلات القائمة.
  pains String[] @default([])
  goals String[] @default([])

  // Path — الطموح الاستراتيجي المُختار في onboarding (شريحة ٤).
  // QUICK = ٠-٣ شهر (مراحل ①②⑤⑥)، MEDIUM = ٣-١٢ (يضيف ③)، LONG = ١٢-٣٦+ (الكل).
  // null → يُعامَل كـ LONG افتراضياً (المستخدمون قبل هذه الميزة).
  strategyPath StrategyPath?
  pathChosenAt DateTime?

  companies     CompanyUser[]
  diagnostics   Diagnostic[]
  sessions      Session[]
  assignedTasks Task[]         @relation("TaskAssignee")
  deals         Deal[]
  notifications Notification[]
}

enum UserType {
  OWNER
  MANAGER
  INVESTOR
}

enum ManagerType {
  INTERNAL
  INDEPENDENT_PRO
}

// مستوى العمل (من يخطّط/ينفّذ) — منفصل عن الأفق الزمني (strategyPath).
// يطابق PlanLevel في العميل (DeptAuditPage) وdecisionAuthority في التشخيص.
enum PlanLevel {
  operational
  tactical
  strategic
}

enum PlanTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum StrategyPath {
  QUICK
  MEDIUM
  LONG
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Group B: Companies & Entities ───────────────────────────────────────────

model Company {
  id         String     @id @default(uuid())
  name       String
  sector     String?
  // R1 — النشاط الفرعي داخل القطاع (مثال: "software" داخل "technology").
  subsector  String?
  // R1 — نوع الكيان القانوني: LLC | JSC | SOLE_PROPRIETOR | ...
  // نص حرّ لتفادي enum جديد؛ التحقق من الطرف السيرفري عبر zod.
  entityType String?
  size       EntitySize
  stage      String?
  country    String     @default("SA")
  logoUrl    String?
  // R1 — OPEX (بيانات تشغيلية غنيّة يُدخلها المدير المستقل في التسجيل، تُستهلَك
  // في KPIs/Ansoff/GapAnalysis/RACI/FinancialAnalysis). Json مرن لتوسيع مستقبلي.
  // شكل مُتوقَّع: { team?: number, budget?: number, target?: number, avgSalary?: number }
  opex       Json?
  // تعريف العميل (اختياريّ) — يُدخَل عند إضافة العميل، يُغذّي تكييف التحليل.
  // شكل مُتوقَّع: { serviceType?: string, pricingModel?: string, customerType?: string }
  profile    Json?
  createdAt  DateTime   @default(now())

  users            CompanyUser[]
  diagnostics      Diagnostic[]
  departments      Department[]
  objectives       Objective[]
  kpis             KPI[]
  initiatives      Initiative[]
  projects         Project[]
  tasks            Task[]
  reviews          Review[]
  scenarios        Scenario[]
  swots            SWOT[]
  complianceAudits ComplianceAudit[]
  reports          Report[]
  artifacts        StrategicArtifact[]
  corrections      Correction[]
  breakEvens       BreakEven[]
  dupontAnalyses   DupontAnalysis[]
  monteCarloRuns   MonteCarloRun[]
  invitations      Invitation[]
  recommendations  Recommendation[]
  assessments      Assessment[]
}

model CompanyUser {
  id        String  @id @default(uuid())
  userId    String
  companyId String
  role      String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

enum EntitySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
}

// ─── Group C: Diagnostic Engine ──────────────────────────────────────────────

model Diagnostic {
  id            String         @id @default(uuid())
  userId        String
  companyId     String
  type          DiagnosticType
  answers       Json
  strategicPath String?
  maturityScore Float?
  radarData     Json?
  weaknesses    Json?
  roadmap       Json?
  scenarios     Json?
  createdAt     DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum DiagnosticType {
  OWNER
  MANAGER
  INVESTOR
}

// ─── Group D: Departments ────────────────────────────────────────────────────

model Department {
  id         String   @id @default(uuid())
  companyId  String
  type       DeptType
  managerId  String?
  auditScore Float?
  auditData  Json?
  kpiData    Json?
  smartData  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kpis    KPI[]
  audits  DeptAudit[]

  @@unique([companyId, type])
}

enum DeptType {
  HR
  FINANCE
  SALES
  MARKETING
  OPERATIONS
  IT
  CUSTOMER_SERVICE
  SUPPORT
  LOGISTICS
  QUALITY
  PROJECTS
  GOVERNANCE
  COMPLIANCE
}

model DeptAudit {
  id           String   @id @default(uuid())
  departmentId String
  auditType    String
  answers      Json
  scores       Json
  totalScore   Float
  healthPct    Float
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ─── Group E: Strategic Lifecycle (SWOT, Objectives, OKRs, KPIs) ─────────────

model SWOT {
  id            String   @id @default(uuid())
  companyId     String
  strengths     Json
  weaknesses    Json
  opportunities Json
  threats       Json
  tows          Json?
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Objective {
  id          String    @id @default(uuid())
  companyId   String
  title       String
  description String?
  type        String
  status      String    @default("active")
  dueDate     DateTime?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  okrs        OKR[]
  kpis        KPI[]
  initiatives Initiative[]

  @@index([companyId])
}

model OKR {
  id           String    @id @default(uuid())
  objectiveId  String
  keyResult    String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String?
  dueDate      DateTime?

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
}

model KPI {
  id           String  @id @default(uuid())
  companyId    String
  departmentId String?
  objectiveId  String?
  name         String
  unit         String
  targetValue  Float
  currentValue Float   @default(0)
  frequency    String

  // ─── حقول القياس المتوقّع (Phase 1) ─────────────────────────────
  // baselineValue: القيمة عند البدء — نقطة انطلاق منحنى S.
  // expectedPath: مسارٌ متوقّع مولّد آليّاً بمنحنى S، قابل للتعديل اليدوي.
  //   شكله: [{ month: 0, value: 0.8 }, { month: 1, value: 0.85 }, ...]
  // startedAt: تاريخ بدء المسار — تحسب منه المدّة المنقضية.
  baselineValue Float?
  expectedPath  Json?
  startedAt     DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  objective  Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  entries    KPIEntry[]

  @@index([companyId])
  @@index([departmentId])
  @@index([objectiveId])
}

model KPIEntry {
  id        String   @id @default(uuid())
  kpiId     String
  value     Float
  notes     String?
  enteredAt DateTime @default(now())

  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
}

// ─── Group F: Projects, Tasks & Execution ────────────────────────────────────

model Initiative {
  id             String     @id @default(uuid())
  companyId      String
  objectiveId    String?
  title          String
  description    String?
  status         String     @default("planned")
  priority       String
  // المستوى (تشغيلي/تكتيكي/استراتيجي) والتكلفة المقدّرة (SAR). كلاهما اختياري.
  level          PlanLevel?
  cost           Decimal?   @db.Decimal(14, 2)
  // مصدر الإنشاء (الرقعة B): 'rescue' = أُنشئت inline من شاشة الإنقاذ (خطوة ٣)،
  // وإلا 'manual'/null. linkedActionId يربطها بالإجراء التصحيحيّ (خطوة ٢).
  // اكتمال الإنقاذ ٣ = وجود مبادرة source='rescue' لهذا العميل.
  source         String?    @default("manual")
  linkedActionId String?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  projects  Project[]

  @@index([companyId])
  @@index([objectiveId])
}

model Project {
  id           String    @id @default(uuid())
  companyId    String
  initiativeId String?
  title        String
  description  String?
  status       String    @default("active")
  startDate    DateTime?
  endDate      DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  initiative Initiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  tasks      Task[]

  @@index([companyId])
  @@index([initiativeId])
}

model Task {
  id          String     @id @default(uuid())
  companyId   String
  projectId   String?
  assigneeId  String?
  // الجهة المنفّذة (نصّ حرّ): شركة/إدارة/شخص يشرف عليه المدير — بلا حساب مستخدم.
  owner       String?
  title       String
  description String?
  status      String     @default("todo")
  priority    String     @default("medium")
  // المستوى والتكلفة المقدّرة (SAR) — اختياريان.
  level       PlanLevel?
  cost        Decimal?   @db.Decimal(14, 2)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  // مهمة فرعية: أبٌ اختياريّ (علاقة ذاتيّة). null = مهمة رئيسيّة. حذف الأب يحذف فروعه.
  parentTaskId String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent   Task?    @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks Task[]   @relation("TaskSubtasks")

  @@index([companyId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([parentTaskId])
}

// ─── Group G: Compliance Audit ───────────────────────────────────────────────

model ComplianceAudit {
  id              String   @id @default(uuid())
  companyId       String
  auditType       String
  answers         Json
  axisScores      Json
  totalScore      Float
  maturityPct     Float
  dangerZone      String
  riskMatrix      Json?
  reformPlan      Json?
  penaltyEstimate Float?
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── Group H: Reviews, Reports & Scenarios ───────────────────────────────────

model Review {
  id          String   @id @default(uuid())
  companyId   String
  type        String
  outcome     String?
  notes       String?
  corrections Json?
  reviewedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Scenario {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  assumptions Json
  projections Json
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Report {
  id           String    @id @default(uuid())
  companyId    String
  type         String
  title        String
  fileUrl      String?
  data         Json?
  shareToken   String?   @unique // رابط عامّ للمشاركة مع مالكٍ لم يسجّل؛ null = غير مشارَك
  shareExpires DateTime?
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── Group I: Strategic lifecycle (Phase 6) ─────────────────────────────────

// Generic container for the analysis artefacts whose data is mostly free-form
// JSON: PESTEL, Porter, benchmarking, stakeholders, org DNA, value chain, core
// capabilities, gap analysis, ambition gap, strategic tensions, directions,
// scenarios overlay, Ansoff/BCG/SPACE/QSPM/Three Horizons matrices, priority
// matrix, OGSM, annual plan, company health snapshot. One row per
// (companyId, type) — the controller upserts.
model StrategicArtifact {
  id        String   @id @default(uuid())
  companyId String
  type      String
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@index([companyId])
}

model Correction {
  id          String    @id @default(uuid())
  companyId   String
  reviewId    String?
  title       String
  description String?
  owner       String?
  status      String    @default("open")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([reviewId])
}

// ─── C12 — نقطة التعادل (BreakEven) ────────────────────────────────────────
// كل حساب يُخزَّن كصف مستقل — يُعطي سجلاً تاريخياً لتطوّر أرقام الشركة عبر
// الزمن (fixedCosts، pricePerUnit، variableCostPerUnit، currentRevenue).
// المخرجات المحسوبة (contributionMargin، breakEvenUnits، safetyMargin،
// insights) تُخزَّن في result: Json لتفادي إعادة الحساب عند القراءة.
model BreakEven {
  id                  String   @id @default(uuid())
  companyId           String
  fixedCosts          Float
  variableCostPerUnit Float
  pricePerUnit        Float
  currentRevenue      Float?
  result              Json
  createdAt           DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── C13 — تحليل Dupont ─────────────────────────────────────────────────────
// ROE = netMargin × assetTurnover × equityMultiplier
// نخزّن العوامل الثلاثة + الناتج roe كسجل مستقل لتتبّع التطوّر عبر الزمن.
model DupontAnalysis {
  id               String   @id @default(uuid())
  companyId        String
  netMargin        Float
  assetTurnover    Float
  equityMultiplier Float
  roe              Float
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── C13 — محاكاة Monte Carlo ──────────────────────────────────────────────
// inputs: كل متغيّر بتوزيع مثلثي { min, likely, max } + iterations.
// results: توزيع النتائج بمقاييس p10/p50/p90 والمتوسط + احتمال الخسارة.
model MonteCarloRun {
  id         String   @id @default(uuid())
  companyId  String
  inputs     Json
  iterations Int
  results    Json
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── C14 — صفقات المستثمر (Deals) ──────────────────────────────────────────
// خط أنابيب صفقات مبسّط. الشركة الهدف تُحفَظ باسم حرّ فقط (لا مفتاح أجنبي)،
// فالمستثمر يمكنه إدخال صفقات لشركات لم يصل لها بعد. القرار MVP: افصل
// الصفقات عن شبكة الشركات القابلة للنقر (PortfolioPage/CompanyDetailPage).
enum DealStatus {
  lead
  due_diligence
  term_sheet
  closed_won
  closed_lost
}

model Deal {
  id                String     @id @default(uuid())
  investorUserId    String
  targetCompanyName String
  sector            String?
  stage             String?
  valuation         Decimal?
  status            DealStatus @default(lead)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  investor User @relation(fields: [investorUserId], references: [id], onDelete: Cascade)

  @@index([investorUserId])
}

// ─── C15 — الإشعارات ───────────────────────────────────────────────────────
// إشعار عام موجّه لمستخدم. type وصف حرّ (مثلاً invitation_received،
// diagnostic_ready، …). read مبدئياً false ويصير true عبر PATCH.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ─── C15 — الدعوات ─────────────────────────────────────────────────────────
// دعوة انضمام لشركة. المُنشئ يجب أن يملك صلاحية على الشركة. القبول: أي
// مستخدم بريده = email المدعو، خلال expiresAt، والحالة pending → يُنشئ
// CompanyUser link ويصير status = accepted.
enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Invitation {
  id        String           @id @default(uuid())
  companyId String
  email     String
  role      String // 'owner' | 'manager' | 'member' — يطابق CompanyUser.role
  token     String           @unique
  status    InvitationStatus @default(pending)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

// ─── C16 — محرك الاستدلال (Recommendations) ────────────────────────────────
// توصيات ناتجة عن قواعد حتمية تقرأ من Diagnostic + DeptAudit + BreakEven.
// severity: info | warning | critical. source: اسم النموذج المصدر أو Composite.
// كل استدعاء POST /generate يحذف التوصيات القديمة لنفس source ثم يعيد الإنشاء.
enum RecommendationSeverity {
  info
  warning
  critical
}

model Recommendation {
  id        String                 @id @default(uuid())
  companyId String
  kind      String
  message   String
  severity  RecommendationSeverity
  source    String
  createdAt DateTime               @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, source])
}

// ─── C17 — محرك التقييم المهيكل ────────────────────────────────────────────
// أربعة نماذج متسلسلة (Assessment → Dimension → Criterion → Indicator).
// modelType يحدّد قالب النموذج (BSC، EFQM، …). status يوضّح مرحلة الدورة.
// maturityScore يُحسَب لاحقاً (C18) عبر الأوزان الموزّنة.
enum AssessmentModelType {
  BSC
  EFQM
  PESTEL
  PORTER
  OKR
  CUSTOM
}

enum AssessmentStatus {
  draft
  active
  completed
  archived
}

model Assessment {
  id            String              @id @default(uuid())
  companyId     String
  name          String
  modelType     AssessmentModelType
  status        AssessmentStatus    @default(draft)
  maturityScore Float?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime            @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dimensions Dimension[]

  @@index([companyId])
}

model Dimension {
  id           String @id @default(uuid())
  assessmentId String
  name         String
  weight       Float
  order        Int    @default(0)

  assessment Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteria   Criterion[]

  @@index([assessmentId])
}

model Criterion {
  id          String @id @default(uuid())
  dimensionId String
  name        String
  weight      Float
  score       Float?

  dimension  Dimension   @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  indicators Indicator[]

  @@index([dimensionId])
}

model Indicator {
  id          String  @id @default(uuid())
  criterionId String
  name        String
  value       Float?
  target      Float?
  unit        String?

  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
}

// الرقعة D: أحداث الرحلة — APPEND-ONLY (يُكتَب فقط؛ لا تحديث/حذف). مستقلّ عمداً
// بلا مفاتيح أجنبيّة (عزل تحليليّ). يقيس فجوة الموصى-به↔المُختار: recommendedTool
// عمود مستقلّ بجانب tool تُستعلَم المقارنة بينهما في التقارير.
model JourneyEvent {
  id              BigInt   @id @default(autoincrement())
  userId          String   @map("user_id")
  clientId        String?  @map("client_id")
  event           String // 'next_shown' | 'next_accepted' | 'next_overridden'
  stageId         String?  @map("stage_id")
  tool            String? // ما اختاره المستخدم فعلاً
  recommendedTool String?  @map("recommended_tool")
  payload         Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clientId, createdAt], map: "idx_journey_events_client")
  @@index([recommendedTool, tool], map: "idx_journey_events_tool")
  @@map("journey_events")
}
