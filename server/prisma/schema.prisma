// STARTIX — full schema. See plan §1.1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Group A: Users & Authentication ─────────────────────────────────────────

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  userType      UserType
  managerType   ManagerType?
  name          String
  phone         String?
  avatarUrl     String?
  plan          PlanTier     @default(BASIC)
  planExpiresAt DateTime?
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  companies      CompanyUser[]
  diagnostics    Diagnostic[]
  sessions       Session[]
  assignedTasks  Task[]        @relation("TaskAssignee")
}

enum UserType {
  OWNER
  MANAGER
  INVESTOR
}

enum ManagerType {
  INTERNAL
  INDEPENDENT_PRO
}

enum PlanTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Group B: Companies & Entities ───────────────────────────────────────────

model Company {
  id        String     @id @default(uuid())
  name      String
  sector    String?
  size      EntitySize
  stage     String?
  country   String     @default("SA")
  logoUrl   String?
  createdAt DateTime   @default(now())

  users            CompanyUser[]
  diagnostics      Diagnostic[]
  departments      Department[]
  objectives       Objective[]
  kpis             KPI[]
  initiatives      Initiative[]
  projects         Project[]
  tasks            Task[]
  reviews          Review[]
  scenarios        Scenario[]
  swots            SWOT[]
  complianceAudits ComplianceAudit[]
  reports          Report[]
}

model CompanyUser {
  id        String  @id @default(uuid())
  userId    String
  companyId String
  role      String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

enum EntitySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
}

// ─── Group C: Diagnostic Engine ──────────────────────────────────────────────

model Diagnostic {
  id            String         @id @default(uuid())
  userId        String
  companyId     String
  type          DiagnosticType
  answers       Json
  strategicPath String?
  maturityScore Float?
  radarData     Json?
  weaknesses    Json?
  roadmap       Json?
  scenarios     Json?
  createdAt     DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum DiagnosticType {
  OWNER
  MANAGER
  INVESTOR
}

// ─── Group D: Departments ────────────────────────────────────────────────────

model Department {
  id         String   @id @default(uuid())
  companyId  String
  type       DeptType
  managerId  String?
  auditScore Float?
  auditData  Json?
  kpiData    Json?
  smartData  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kpis    KPI[]
  audits  DeptAudit[]

  @@unique([companyId, type])
}

enum DeptType {
  HR
  FINANCE
  SALES
  MARKETING
  OPERATIONS
  IT
  CUSTOMER_SERVICE
  SUPPORT
  LOGISTICS
  QUALITY
  PROJECTS
  GOVERNANCE
  COMPLIANCE
}

model DeptAudit {
  id           String   @id @default(uuid())
  departmentId String
  auditType    String
  answers      Json
  scores       Json
  totalScore   Float
  healthPct    Float
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ─── Group E: Strategic Lifecycle (SWOT, Objectives, OKRs, KPIs) ─────────────

model SWOT {
  id            String   @id @default(uuid())
  companyId     String
  strengths     Json
  weaknesses    Json
  opportunities Json
  threats       Json
  tows          Json?
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Objective {
  id          String    @id @default(uuid())
  companyId   String
  title       String
  description String?
  type        String
  status      String    @default("active")
  dueDate     DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  okrs    OKR[]
  kpis    KPI[]

  @@index([companyId])
}

model OKR {
  id           String    @id @default(uuid())
  objectiveId  String
  keyResult    String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String?
  dueDate      DateTime?

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
}

model KPI {
  id           String  @id @default(uuid())
  companyId    String
  departmentId String?
  objectiveId  String?
  name         String
  unit         String
  targetValue  Float
  currentValue Float   @default(0)
  frequency    String

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  objective  Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  entries    KPIEntry[]

  @@index([companyId])
  @@index([departmentId])
  @@index([objectiveId])
}

model KPIEntry {
  id        String   @id @default(uuid())
  kpiId     String
  value     Float
  notes     String?
  enteredAt DateTime @default(now())

  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
}

// ─── Group F: Projects, Tasks & Execution ────────────────────────────────────

model Initiative {
  id          String  @id @default(uuid())
  companyId   String
  title       String
  description String?
  status      String  @default("planned")
  priority    String

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([companyId])
}

model Project {
  id           String    @id @default(uuid())
  companyId    String
  initiativeId String?
  title        String
  description  String?
  status       String    @default("active")
  startDate    DateTime?
  endDate      DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  initiative Initiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  tasks      Task[]

  @@index([companyId])
  @@index([initiativeId])
}

model Task {
  id          String    @id @default(uuid())
  companyId   String
  projectId   String?
  assigneeId  String?
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([assigneeId])
}

// ─── Group G: Compliance Audit ───────────────────────────────────────────────

model ComplianceAudit {
  id              String   @id @default(uuid())
  companyId       String
  auditType       String
  answers         Json
  axisScores      Json
  totalScore      Float
  maturityPct     Float
  dangerZone      String
  riskMatrix      Json?
  reformPlan      Json?
  penaltyEstimate Float?
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── Group H: Reviews, Reports & Scenarios ───────────────────────────────────

model Review {
  id          String   @id @default(uuid())
  companyId   String
  type        String
  outcome     String?
  notes       String?
  corrections Json?
  reviewedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Scenario {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  assumptions Json
  projections Json
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Report {
  id        String   @id @default(uuid())
  companyId String
  type      String
  title     String
  fileUrl   String?
  data      Json?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
