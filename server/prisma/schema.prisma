// STARTIX — full schema. See plan §1.1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Group A: Users & Authentication ─────────────────────────────────────────

model User {
  id                         String       @id @default(uuid())
  email                      String       @unique
  passwordHash               String
  userType                   UserType
  managerType                ManagerType?
  name                       String
  phone                      String?
  avatarUrl                  String?
  plan                       PlanTier     @default(BASIC)
  planExpiresAt              DateTime?
  isVerified                 Boolean      @default(false)
  emailVerificationToken     String?      @unique
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?      @unique
  passwordResetExpiresAt     DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  // التخصّص للمدير المستقل (INDEPENDENT_PRO): يحدّد أي إدارة يشرف عليها
  // عبر عملائه المتعدّدين. null لكل الأنواع الأخرى.
  specialtyDeptType          DeptType?

  companies      CompanyUser[]
  diagnostics    Diagnostic[]
  sessions       Session[]
  assignedTasks  Task[]        @relation("TaskAssignee")
  deals          Deal[]
  notifications  Notification[]
}

enum UserType {
  OWNER
  MANAGER
  INVESTOR
}

enum ManagerType {
  INTERNAL
  INDEPENDENT_PRO
}

enum PlanTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Group B: Companies & Entities ───────────────────────────────────────────

model Company {
  id        String     @id @default(uuid())
  name      String
  sector    String?
  size      EntitySize
  stage     String?
  country   String     @default("SA")
  logoUrl   String?
  createdAt DateTime   @default(now())

  users            CompanyUser[]
  diagnostics      Diagnostic[]
  departments      Department[]
  objectives       Objective[]
  kpis             KPI[]
  initiatives      Initiative[]
  projects         Project[]
  tasks            Task[]
  reviews          Review[]
  scenarios        Scenario[]
  swots            SWOT[]
  complianceAudits ComplianceAudit[]
  reports          Report[]
  artifacts        StrategicArtifact[]
  corrections      Correction[]
  breakEvens       BreakEven[]
  dupontAnalyses   DupontAnalysis[]
  monteCarloRuns   MonteCarloRun[]
  invitations      Invitation[]
  recommendations  Recommendation[]
  assessments      Assessment[]
}

model CompanyUser {
  id        String  @id @default(uuid())
  userId    String
  companyId String
  role      String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

enum EntitySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
}

// ─── Group C: Diagnostic Engine ──────────────────────────────────────────────

model Diagnostic {
  id            String         @id @default(uuid())
  userId        String
  companyId     String
  type          DiagnosticType
  answers       Json
  strategicPath String?
  maturityScore Float?
  radarData     Json?
  weaknesses    Json?
  roadmap       Json?
  scenarios     Json?
  createdAt     DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum DiagnosticType {
  OWNER
  MANAGER
  INVESTOR
}

// ─── Group D: Departments ────────────────────────────────────────────────────

model Department {
  id         String   @id @default(uuid())
  companyId  String
  type       DeptType
  managerId  String?
  auditScore Float?
  auditData  Json?
  kpiData    Json?
  smartData  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kpis    KPI[]
  audits  DeptAudit[]

  @@unique([companyId, type])
}

enum DeptType {
  HR
  FINANCE
  SALES
  MARKETING
  OPERATIONS
  IT
  CUSTOMER_SERVICE
  SUPPORT
  LOGISTICS
  QUALITY
  PROJECTS
  GOVERNANCE
  COMPLIANCE
}

model DeptAudit {
  id           String   @id @default(uuid())
  departmentId String
  auditType    String
  answers      Json
  scores       Json
  totalScore   Float
  healthPct    Float
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ─── Group E: Strategic Lifecycle (SWOT, Objectives, OKRs, KPIs) ─────────────

model SWOT {
  id            String   @id @default(uuid())
  companyId     String
  strengths     Json
  weaknesses    Json
  opportunities Json
  threats       Json
  tows          Json?
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Objective {
  id          String    @id @default(uuid())
  companyId   String
  title       String
  description String?
  type        String
  status      String    @default("active")
  dueDate     DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  okrs    OKR[]
  kpis    KPI[]

  @@index([companyId])
}

model OKR {
  id           String    @id @default(uuid())
  objectiveId  String
  keyResult    String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String?
  dueDate      DateTime?

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
}

model KPI {
  id           String  @id @default(uuid())
  companyId    String
  departmentId String?
  objectiveId  String?
  name         String
  unit         String
  targetValue  Float
  currentValue Float   @default(0)
  frequency    String

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  objective  Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  entries    KPIEntry[]

  @@index([companyId])
  @@index([departmentId])
  @@index([objectiveId])
}

model KPIEntry {
  id        String   @id @default(uuid())
  kpiId     String
  value     Float
  notes     String?
  enteredAt DateTime @default(now())

  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
}

// ─── Group F: Projects, Tasks & Execution ────────────────────────────────────

model Initiative {
  id          String  @id @default(uuid())
  companyId   String
  title       String
  description String?
  status      String  @default("planned")
  priority    String

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([companyId])
}

model Project {
  id           String    @id @default(uuid())
  companyId    String
  initiativeId String?
  title        String
  description  String?
  status       String    @default("active")
  startDate    DateTime?
  endDate      DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  initiative Initiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  tasks      Task[]

  @@index([companyId])
  @@index([initiativeId])
}

model Task {
  id          String    @id @default(uuid())
  companyId   String
  projectId   String?
  assigneeId  String?
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([assigneeId])
}

// ─── Group G: Compliance Audit ───────────────────────────────────────────────

model ComplianceAudit {
  id              String   @id @default(uuid())
  companyId       String
  auditType       String
  answers         Json
  axisScores      Json
  totalScore      Float
  maturityPct     Float
  dangerZone      String
  riskMatrix      Json?
  reformPlan      Json?
  penaltyEstimate Float?
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── Group H: Reviews, Reports & Scenarios ───────────────────────────────────

model Review {
  id          String   @id @default(uuid())
  companyId   String
  type        String
  outcome     String?
  notes       String?
  corrections Json?
  reviewedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Scenario {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  assumptions Json
  projections Json
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Report {
  id        String   @id @default(uuid())
  companyId String
  type      String
  title     String
  fileUrl   String?
  data      Json?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── Group I: Strategic lifecycle (Phase 6) ─────────────────────────────────

// Generic container for the analysis artefacts whose data is mostly free-form
// JSON: PESTEL, Porter, benchmarking, stakeholders, org DNA, value chain, core
// capabilities, gap analysis, ambition gap, strategic tensions, directions,
// scenarios overlay, Ansoff/BCG/SPACE/QSPM/Three Horizons matrices, priority
// matrix, OGSM, annual plan, company health snapshot. One row per
// (companyId, type) — the controller upserts.
model StrategicArtifact {
  id        String   @id @default(uuid())
  companyId String
  type      String
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@index([companyId])
}

model Correction {
  id          String    @id @default(uuid())
  companyId   String
  reviewId    String?
  title       String
  description String?
  owner       String?
  status      String    @default("open")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([reviewId])
}

// ─── C12 — نقطة التعادل (BreakEven) ────────────────────────────────────────
// كل حساب يُخزَّن كصف مستقل — يُعطي سجلاً تاريخياً لتطوّر أرقام الشركة عبر
// الزمن (fixedCosts، pricePerUnit، variableCostPerUnit، currentRevenue).
// المخرجات المحسوبة (contributionMargin، breakEvenUnits، safetyMargin،
// insights) تُخزَّن في result: Json لتفادي إعادة الحساب عند القراءة.
model BreakEven {
  id                  String   @id @default(uuid())
  companyId           String
  fixedCosts          Float
  variableCostPerUnit Float
  pricePerUnit        Float
  currentRevenue      Float?
  result              Json
  createdAt           DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── C13 — تحليل Dupont ─────────────────────────────────────────────────────
// ROE = netMargin × assetTurnover × equityMultiplier
// نخزّن العوامل الثلاثة + الناتج roe كسجل مستقل لتتبّع التطوّر عبر الزمن.
model DupontAnalysis {
  id                String   @id @default(uuid())
  companyId         String
  netMargin         Float
  assetTurnover     Float
  equityMultiplier  Float
  roe               Float
  createdAt         DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── C13 — محاكاة Monte Carlo ──────────────────────────────────────────────
// inputs: كل متغيّر بتوزيع مثلثي { min, likely, max } + iterations.
// results: توزيع النتائج بمقاييس p10/p50/p90 والمتوسط + احتمال الخسارة.
model MonteCarloRun {
  id         String   @id @default(uuid())
  companyId  String
  inputs     Json
  iterations Int
  results    Json
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── C14 — صفقات المستثمر (Deals) ──────────────────────────────────────────
// خط أنابيب صفقات مبسّط. الشركة الهدف تُحفَظ باسم حرّ فقط (لا مفتاح أجنبي)،
// فالمستثمر يمكنه إدخال صفقات لشركات لم يصل لها بعد. القرار MVP: افصل
// الصفقات عن شبكة الشركات القابلة للنقر (PortfolioPage/CompanyDetailPage).
enum DealStatus {
  lead
  due_diligence
  term_sheet
  closed_won
  closed_lost
}

model Deal {
  id                String     @id @default(uuid())
  investorUserId    String
  targetCompanyName String
  sector            String?
  stage             String?
  valuation         Decimal?
  status            DealStatus @default(lead)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  investor User @relation(fields: [investorUserId], references: [id], onDelete: Cascade)

  @@index([investorUserId])
}

// ─── C15 — الإشعارات ───────────────────────────────────────────────────────
// إشعار عام موجّه لمستخدم. type وصف حرّ (مثلاً invitation_received،
// diagnostic_ready، …). read مبدئياً false ويصير true عبر PATCH.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ─── C15 — الدعوات ─────────────────────────────────────────────────────────
// دعوة انضمام لشركة. المُنشئ يجب أن يملك صلاحية على الشركة. القبول: أي
// مستخدم بريده = email المدعو، خلال expiresAt، والحالة pending → يُنشئ
// CompanyUser link ويصير status = accepted.
enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Invitation {
  id        String           @id @default(uuid())
  companyId String
  email     String
  role      String           // 'owner' | 'manager' | 'member' — يطابق CompanyUser.role
  token     String           @unique
  status    InvitationStatus @default(pending)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

// ─── C16 — محرك الاستدلال (Recommendations) ────────────────────────────────
// توصيات ناتجة عن قواعد حتمية تقرأ من Diagnostic + DeptAudit + BreakEven.
// severity: info | warning | critical. source: اسم النموذج المصدر أو Composite.
// كل استدعاء POST /generate يحذف التوصيات القديمة لنفس source ثم يعيد الإنشاء.
enum RecommendationSeverity {
  info
  warning
  critical
}

model Recommendation {
  id        String                 @id @default(uuid())
  companyId String
  kind      String
  message   String
  severity  RecommendationSeverity
  source    String
  createdAt DateTime               @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, source])
}

// ─── C17 — محرك التقييم المهيكل ────────────────────────────────────────────
// أربعة نماذج متسلسلة (Assessment → Dimension → Criterion → Indicator).
// modelType يحدّد قالب النموذج (BSC، EFQM، …). status يوضّح مرحلة الدورة.
// maturityScore يُحسَب لاحقاً (C18) عبر الأوزان الموزّنة.
enum AssessmentModelType {
  BSC
  EFQM
  PESTEL
  PORTER
  OKR
  CUSTOM
}

enum AssessmentStatus {
  draft
  active
  completed
  archived
}

model Assessment {
  id            String              @id @default(uuid())
  companyId     String
  name          String
  modelType     AssessmentModelType
  status        AssessmentStatus    @default(draft)
  maturityScore Float?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime            @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dimensions Dimension[]

  @@index([companyId])
}

model Dimension {
  id           String @id @default(uuid())
  assessmentId String
  name         String
  weight       Float
  order        Int    @default(0)

  assessment Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteria   Criterion[]

  @@index([assessmentId])
}

model Criterion {
  id          String @id @default(uuid())
  dimensionId String
  name        String
  weight      Float
  score       Float?

  dimension  Dimension   @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  indicators Indicator[]

  @@index([dimensionId])
}

model Indicator {
  id          String  @id @default(uuid())
  criterionId String
  name        String
  value       Float?
  target      Float?
  unit        String?

  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
}
