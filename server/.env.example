# Copy to .env and fill in real values. Never commit .env.
# This template lists everything the server checks via /health/config.

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Use the "Connect" button in Supabase → ORMs → Prisma to get both strings.
# Pooler (port 6543) for runtime; direct/session (port 5432) for migrations.
# URL-encode special chars in the password (@ → %40, * → %2A, etc.).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a long random string: `openssl rand -base64 48`
JWT_SECRET="replace-with-long-random-string"

# ── AI (Anthropic Claude) ─────────────────────────────────────────────────────
# Without this key the AI routes return a graceful "AI is unavailable" message
# rather than crashing. Smart Guide degrades to a static hint.
ANTHROPIC_API_KEY="sk-ant-..."

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# All three are required for self-serve checkout to work.
# Without them, /api/payments/create-checkout returns 503 in Arabic and the
# pricing page shows a "تواصل مع المبيعات" CTA instead of a checkout button.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PROFESSIONAL="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ── AWS (SES + S3) ────────────────────────────────────────────────────────────
# Used for transactional email (verify, reset, invites) and report storage.
# Without these, emails log to console and reports stay DB-only.
AWS_REGION="me-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_ADDRESS="no-reply@startix.sa"
S3_BUCKET="startix-reports"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
