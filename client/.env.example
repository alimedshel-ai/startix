# Copy to .env and fill in real values. Never commit .env.
# All Vite env vars must be prefixed with VITE_ to be exposed to the browser.

# Base URL of the Startix API. In production set this to the EB CNAME
# or the api.startix.sa domain that points at it.
VITE_API_URL="http://localhost:5001"

# Public Stripe key. Safe to expose — the secret key lives only on the server.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
